#!/bin/bash
# Wird beim Deinstallieren ausgefuehrt: Container stoppen/entfernen + lokal
# gebautes Image loeschen (Fork - kein Registry-Image zu entfernen).
echo "<INFO> Stoppe tilebert-Container (Favoriten-Fork)..."
docker rm -f loxpanelfav > /dev/null 2>&1

echo "<INFO> Entferne lokal gebautes tilebert-Image..."
docker image rm loxpanelfav:local > /dev/null 2>&1

echo "<OK> tilebert (Favoriten-Fork) entfernt. (Panel-Daten im Plugin-data-Ordner werden von LoxBerry mitentfernt.)"
exit 0
